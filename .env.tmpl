# Everything can be set in the web UI instead. These are only read on first start,
# to fill in settings.json.

# Languages to keep (names or codes, separated by commas)
AUDIO_LANGUAGES=English
SUBTITLE_LANGUAGES=English
STRIP_AUDIO=True
STRIP_SUBTITLES=True
STRIP_COMMENTARY=True

# Report only: list what would change, but don't change anything by itself
REPORT_ONLY=True
SCAN_INTERVAL_HOURS=24
# Only change files between these hours (the same hour twice means any time)
ACTIVE_FROM=1
ACTIVE_UNTIL=7
MAX_CHANGES_PER_PASS=25
PROCESS_HARDLINKED=False

# Keep originals in the recycle folder for this many days (0 deletes them)
RECYCLE_DAYS=7
RECYCLE_FOLDER=

# Library folders inside the container, separated by commas
LIBRARIES=/movies,/tv

# Radarr
RADARR_URL=<<RADARR IP ADDRESS OR HOSTNAME>>:7878
RADARR_API_KEY=<<RADARR API KEY>>
# Only if Radarr sees the files under a different folder: Radarr's folder=Dubarr's folder
RADARR_PATH_MAP=

# Sonarr
SONARR_URL=<<SONARR IP ADDRESS OR HOSTNAME>>:8989
SONARR_API_KEY=<<SONARR API KEY>>
SONARR_PATH_MAP=

# Jellyfin
JELLYFIN_URL=<<JELLYFIN IP ADDRESS OR HOSTNAME>>:8096
JELLYFIN_API_KEY=<<JELLYFIN API KEY>>
JELLYFIN_PATH_MAP=
